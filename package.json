{
  "name": "maquis18",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:migrate": "yarn workspace @maquis18/api prisma migrate dev",
    "db:seed": "yarn workspace @maquis18/api prisma db seed",
    "test:e2e": "yarn workspace @maquis18/api test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@1.22.22"
}
