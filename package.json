{
  "name": "maquis18",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:migrate": "yarn workspace @maquis18/api prisma migrate dev",
    "db:seed": "yarn workspace @maquis18/api prisma db seed",
    "test:e2e": "yarn workspace @maquis18/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "images:generate": "yarn workspace @maquis18/api images:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "yarn@1.22.22"
}
