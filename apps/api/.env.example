DATABASE_URL="postgresql://maquis18:maquis18@localhost:5435/maquis18?schema=public"
PORT=5000
WEB_ORIGIN="http://localhost:3001"
# HOST=0.0.0.0
# APP_URL="https://api.maquis18.com"

# ---------- Back-office ----------
# Long random string used to sign the admin JWTs (generate one with: openssl rand -hex 32)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"
# Admin account created by `yarn db:seed`
ADMIN_EMAIL="admin@maquis18.fr"
ADMIN_PASSWORD="change-me"

# ---------- Reservations ----------
# Maximum number of guests per quarter-hour slot
RESERVATION_SLOT_CAPACITY=12

# ---------- E-mails ----------
# Local default (no need to set it): Mailpit from docker-compose, web interface on http://localhost:8025
# Production: SMTP settings of your provider (Brevo, Resend, Mailgun…)
# SMTP_HOST="localhost"
# SMTP_PORT=1026
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Maquis 18 <reservations@maquis18.fr>"

# ---------- Anti-spam ----------
# Cloudflare Turnstile secret key. Without it, the captcha check is skipped (development only).
# This test secret always passes; use your real key in production.
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Set to true behind a hosting proxy (Railway, Render…) so rate limiting sees the real visitor IP
# TRUST_PROXY=true

# ---------- SMS ----------
# "log" (default): SMS are only written in the API logs
# "textbee": sent from your Android phone through textbee.dev (free: 300 SMS/month, 50/day)
# "twilio": sent through Twilio (a trial account only accepts Twilio's predefined templates)
# SMS_PROVIDER=textbee
# textbee dashboard (app.textbee.dev) → API key; device ID is optional (Devices panel)
# TEXTBEE_API_KEY=""
# TEXTBEE_DEVICE_ID=""
# Twilio console → Account → API keys & tokens.
#   Free simulation: use the TEST Account SID / Auth Token and TWILIO_FROM="+15005550006" (nothing is delivered)
#   Real SMS on a trial account: live credentials + your Twilio number; recipients must be verified numbers
 TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxx"
 TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+15005550006"
