# Used by the server (Server Components) to fetch the menu
API_URL="http://localhost:5000"
# Used by the browser (reservation form) — NEXT_PUBLIC_ variables are exposed to the client
NEXT_PUBLIC_API_URL="http://localhost:5000"
# Cloudflare Turnstile site key (public). This test key always passes: replace it in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Public URL of the site (canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
